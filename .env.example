# Copia este archivo como `.env` y ajusta los valores.
# `.env` está en .gitignore: tus secretos nunca se suben a GitHub.

# --- Fuente de datos: SECOP II en datos.gov.co (API Socrata) ---
SECOP_BASE_URL=https://www.datos.gov.co/resource
SECOP_DATASET_ID=jbjy-vk9h
# Opcional: un "App Token" gratuito de datos.gov.co evita límites de peticiones.
SECOP_APP_TOKEN=

# --- Base de datos (se usará desde la Fase 2) ---
POSTGRES_USER=veedor
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=veedor_secop
